- name: Calls gtmOnFailure when the loader script cannot be loaded
  code: |-
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      onFailure();
    });

    runCode({widgetId: '123e4567-e89b-12d3-a456-426614174000'});

