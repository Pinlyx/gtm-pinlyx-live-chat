___TESTS___

scenarios:
- name: Injects the widget loader with the widget ID
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });

    runCode({widgetId: '123e4567-e89b-12d3-a456-426614174000'});

    assertThat(injected.length).isEqualTo(1);
    assertThat(injected[0]).isEqualTo('https://api.pinlyx.com/js/widget.js?id=123e4567-e89b-12d3-a456-426614174000');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Trims spaces around a pasted widget ID
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });

    runCode({widgetId: '  123e4567-e89b-12d3-a456-426614174000 '});

    assertThat(injected[0]).isEqualTo('https://api.pinlyx.com/js/widget.js?id=123e4567-e89b-12d3-a456-426614174000');
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails without loading anything when the widget ID is empty
  code: |-
    let calls = 0;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      calls++;
      onSuccess();
    });

    runCode({widgetId: ''});

    assertThat(calls).isEqualTo(0);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Fails when the widget ID has unexpected characters
  code: |-
    let calls = 0;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      calls++;
      onSuccess();
    });

    runCode({widgetId: '123e4567-e89b-12d3-a456-42661417400g'});

    assertThat(calls).isEqualTo(0);
    assertApi('gtmOnFailure').wasCalled();
- name: Loads the Live Visitors script after the widget when enabled
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });

    runCode({widgetId: '123e4567-e89b-12d3-a456-426614174000', enableAnalytics: true, analyticsSiteId: '9b2c1d4e-7f60-4a8b-93c5-0d1e2f3a4b5c'});

    assertThat(injected.length).isEqualTo(2);
    assertThat(injected[0]).isEqualTo('https://api.pinlyx.com/js/widget.js?id=123e4567-e89b-12d3-a456-426614174000');
    assertThat(injected[1]).isEqualTo('https://api.pinlyx.com/js/cs.js?id=9b2c1d4e-7f60-4a8b-93c5-0d1e2f3a4b5c');
    assertApi('gtmOnSuccess').wasCalled();
- name: Does not load Live Visitors when the box is unchecked
  code: |-
    const injected = [];
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      injected.push(url);
      onSuccess();
    });

    runCode({widgetId: '123e4567-e89b-12d3-a456-426614174000', enableAnalytics: false, analyticsSiteId: '9b2c1d4e-7f60-4a8b-93c5-0d1e2f3a4b5c'});

    assertThat(injected.length).isEqualTo(1);
    assertApi('gtmOnSuccess').wasCalled();
- name: Fails when Live Visitors is enabled with an invalid site ID
  code: |-
    let calls = 0;
    mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
      calls++;
      onSuccess();
