___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const encodeUriComponent = require('encodeUriComponent');
const makeString = require('makeString');
const logToConsole = require('logToConsole');

const BASE_URL = 'https://api.pinlyx.com/js/';
const HEX = '0123456789abcdef';

// Removes leading and trailing spaces, tabs and line breaks (copy and paste leftovers).
const clean = (value) => {
  const s = makeString(value || '');
  let start = 0;
  let end = s.length;
  const isSpace = (c) => c === ' ' || c === '\t' || c === '\n' || c === '\r';
  while (start < end && isSpace(s.charAt(start))) start++;
  while (end > start && isSpace(s.charAt(end - 1))) end--;
  return s.substring(start, end);
};

// Pinlyx ids are UUIDs: 8-4-4-4-12 hexadecimal characters (36 in total).
const isValidId = (id) => {
  if (id.length !== 36) return false;
  const lower = id.toLowerCase();
  for (let i = 0; i < 36; i++) {
    const c = lower.charAt(i);
    if (i === 8 || i === 13 || i === 18 || i === 23) {
      if (c !== '-') return false;
    } else if (HEX.indexOf(c) === -1) {
      return false;
    }
  }
  return true;
};

const widgetId = clean(data.widgetId);
if (!isValidId(widgetId)) {
  logToConsole('Pinlyx Live Chat: the widget ID is not a valid UUID, nothing was loaded.');
  data.gtmOnFailure();
  return;
}

let analyticsId = '';
if (data.enableAnalytics) {
  analyticsId = clean(data.analyticsSiteId);
  if (!isValidId(analyticsId)) {
    logToConsole('Pinlyx Live Chat: the Live Visitors site ID is not a valid UUID, nothing was loaded.');
    data.gtmOnFailure();
    return;
  }
}

const widgetUrl = BASE_URL + 'widget.js?id=' + encodeUriComponent(widgetId);

const loadAnalytics = () => {
  if (!analyticsId) {
    data.gtmOnSuccess();
    return;
  }
  const analyticsUrl = BASE_URL + 'cs.js?id=' + encodeUriComponent(analyticsId);
  // The cache token makes sure the script is requested only once per page.
  injectScript(analyticsUrl, data.gtmOnSuccess, data.gtmOnFailure, 'pinlyx-visitors-' + analyticsId);
};

injectScript(widgetUrl, loadAnalytics, data.gtmOnFailure, 'pinlyx-widget-' + widgetId);

